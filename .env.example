# StudyPilot frontend — public environment (Vite)
# Copy to .env.local and fill in. Only these four variables are allowed in the
# frontend. Backend secrets (service-role key, DB password, Groq/Gemini keys)
# must NEVER appear here or in any VITE_ variable — see backend/.env.example.

# Supabase project (public by design; protected by RLS and backend JWT checks)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# FastAPI backend base URL (must include /api/v1)
VITE_API_URL=http://localhost:7860/api/v1

# true = demo mode: mock data only, no backend or Supabase needed.
# false = real mode: Supabase auth + FastAPI backend required.
VITE_USE_MOCK=false
