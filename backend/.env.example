# ---- AI (add at least one key) ----
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDERS=groq,gemini
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash

# ---- Supabase (login only; nothing else is stored there) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only needed for old projects whose tokens are HS256. New projects use JWKS automatically.
SUPABASE_JWT_SECRET=

# ---- Retrieval ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
ANSWER_MIN_SCORE=0.40

# ---- Limits ----
MAX_UPLOAD_MB=25
DAILY_AI_REQUESTS_PER_USER=500
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
